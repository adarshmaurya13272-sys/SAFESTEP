# ============================================================
# SAFESTEP — Environment Variables
# Copy this file to .env and fill in values
# ============================================================

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://safestep:safestep_dev@localhost:5432/safestep?schema=public"

# ── Auth ──────────────────────────────────────────────────────
# Secret for signing JWT access tokens (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"

# Secret for signing JWT refresh tokens
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"

# Token expiry durations
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── Server ────────────────────────────────────────────────────
# Port for the Express API server
API_PORT=4000

# Port for the Next.js dev server
WEB_PORT=3000

# Allowed CORS origin (frontend URL)
CORS_ORIGIN="http://localhost:3000"

# Node environment
NODE_ENV="development"

# ── External Services ────────────────────────────────────────
# OSRM routing server (public instance, no key needed)
OSRM_BASE_URL="https://router.project-osrm.org"

# Nominatim geocoding (public instance, no key needed)
# IMPORTANT: Respect usage policy — include User-Agent, debounce, cache
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# Overpass API for POI queries
OVERPASS_BASE_URL="https://overpass-api.de/api/interpreter"

# ── Notifications (optional) ─────────────────────────────────
# Twilio credentials — leave empty to use ConsoleProvider (default)
# Real SMS delivery is a PLANNED feature
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Demo Mode ─────────────────────────────────────────────────
# Set to "true" to use recorded fixtures instead of live APIs
# Enables GPS simulator and offline operation for hackathon demos
DEMO_MODE="false"

# Demo city center coordinates (used for seeding demo incidents)
DEMO_CENTER_LAT="28.6139"
DEMO_CENTER_LNG="77.2090"

# ── Security ──────────────────────────────────────────────────
# Cookie domain (leave empty for localhost)
COOKIE_DOMAIN=""

# Rate limiting: max requests per window
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# Strict rate limit for auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_RATE_LIMIT_MAX="20"
